# npm ignore — defense in depth
#
# The authoritative control is the "files" allowlist in package.json.
# This file exists so that IF that array is ever removed, this repo does not
# fall back to .gitignore — which excludes "dist" and would otherwise ship a
# package containing no code at all.
#
# IMPORTANT: when .npmignore exists, npm ignores .gitignore entirely. Every
# rule that must hold is therefore repeated here, not left to .gitignore.
#
# Files listed under "files" in package.json cannot be excluded from here.

# Source and build inputs
src/
tsconfig.json
*.tsbuildinfo
vitest.config.ts
vitest.e2e.config.ts

# Dependencies and lockfiles
node_modules/
package-lock.json

# Tests and coverage
*.test.*
*.spec.*
e2e/
coverage/

# Local tooling state, CI and agent scratch
.opencode/
.superpowers/
graphify-out/
.github/
.gitattributes
AGENTS.md
.DS_Store
*.log
.env
.env.*

# dist/ and catalog/ are intentionally NOT listed — they ship.
